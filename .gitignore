# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Local tooling caches
.cache/
.local/

# Secrets — never commit real environment values
.env
.env.*
!.env.example

# Uploaded files — fileStorage.ts's private, organization-scoped storage tree
# (UPLOADS_DIR, default <cwd>/uploads). Real customer content: employee
# avatars, organization branding, employee/candidate documents, and WS-5
# organization documents and generated letters. Never belongs in git.
uploads/

# MCP server config — may contain embedded connection credentials
# (e.g. the Supabase MCP server's authenticated URL)
.mcp.json
