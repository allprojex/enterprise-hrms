# Copy this file to .env and fill in real values. Never commit .env.

# --- artifacts/api-server ---

# PostgreSQL connection string. Required by both the API server and
# `pnpm --filter @workspace/db run push`.
DATABASE_URL=postgres://user:password@localhost:5432/hrms

# Port the API server listens on.
PORT=3001

# development | production
NODE_ENV=development

# Comma-separated list of origins allowed to call the API, e.g.
# https://app.example.com,https://admin.example.com
# Leave unset in development to allow all origins.
CORS_ORIGIN=

# Public URL of the frontend (artifacts/hrms), used to build links inside
# transactional emails (e.g. the password reset link). No trailing slash.
APP_BASE_URL=http://localhost:5173

# Resend API key (https://resend.com/api-keys). Required to send
# transactional email (currently just forgot-password). If unset, requests
# are accepted but no email is sent -- failures are logged, never surfaced,
# so the caller can't use them to enumerate registered accounts.
RESEND_API_KEY=

# Verified Resend sender, e.g. "Enterprise HRMS <no-reply@yourdomain.com>".
EMAIL_FROM_ADDRESS=

# Optional release/build identifier (e.g. a git commit SHA, a CI build
# number) surfaced by GET /healthz for deploy verification and support
# triage. Never required, never guessed -- if unset, /healthz reports
# version "unknown" rather than fabricating one. GIT_COMMIT_SHA is accepted
# as a fallback name for the same value.
RELEASE_VERSION=

# Absolute path to the directory holding uploaded document binaries —
# employee and organization documents, evidence files, generated PDFs,
# résumés, avatars and bulk-import source files. Defaults to
# `<cwd>/uploads` when unset; the Docker image sets it to
# /var/lib/hrms/uploads.
#
# REQUIRED FOR ANY CONTAINERIZED DEPLOYMENT: this directory holds
# authoritative business data that does NOT live in PostgreSQL, so a database
# backup alone does not protect it. It must point at storage that survives
# container replacement (a mounted volume or host path), and every process
# that touches uploads — the API server AND the worker — must be given the
# same location.
#
# Persistence is not backup: surviving a restart is not the same as surviving
# volume deletion or host loss. See docs/DEPLOYMENT_AND_TENANT_ARCHITECTURE.md §6.
UPLOADS_DIR=

# Which storage backend holds uploaded binaries: `filesystem` (default) or
# `s3`. This is an INSTALLATION/ENVIRONMENT decision — never a tenant
# setting, never per-organization, never user-selectable. Credentials would
# have to become tenant data for that to work, which is not acceptable.
#
# filesystem: uses UPLOADS_DIR above. The default, so development, tests and
#   self-managed installations need no object storage at all.
# s3: any S3-COMPATIBLE object store (AWS S3, MinIO, Ceph, R2, B2, Spaces,
#   Supabase Storage's S3 endpoint). There is no provider-specific setting
#   and no provider-specific code path.
#
# Selecting s3 without the credentials below fails LOUDLY at startup rather
# than silently falling back to the filesystem — a silent fallback would put
# authoritative business data somewhere the operator does not back up.
STORAGE_BACKEND=filesystem

# Required when STORAGE_BACKEND=s3. Secrets: environment only. They must
# never appear in a database row, an API response, a log line or the
# frontend, and must never be committed.
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Optional. Region defaults to us-east-1. Set an endpoint for any non-AWS
# provider, and force path-style addressing for most self-hosted servers.
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=

# --- artifacts/hrms ---

# Port the Vite dev server listens on (frontend and API server need
# different ports when run together locally).
# PORT=5173

# URL prefix the frontend is served from.
# BASE_PATH=/

# Optional. The `installations.installation_key` this process is deployed
# as (Platform Admin -> Installations). When set, every structured log line
# carries `installation_key` and the Super Admin tenant identity card reports
# which deployment served the request. Never required, never guessed.
# INSTALLATION_KEY=
